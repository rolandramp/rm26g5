{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RAG: Run Experiment",
      "type": "debugpy",
      "request": "launch",
      "module": "rag_framework.cli",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "run-experiment",
        "--config",
        "config/experiment_config_local.yaml",
        "--output",
        "results",
        "--run-all"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
